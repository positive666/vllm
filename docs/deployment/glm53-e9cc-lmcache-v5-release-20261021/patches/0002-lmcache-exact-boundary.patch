+    @staticmethod
+    def GetBoundaryStoreMetadata(
+        tracker: LMCacheMPRequestTracker,
+        boundary_states: list[tuple[int, int, int]],
+        lmcache_tokens_per_chunk: int,
+        group_tokens_per_block: list[int],
+        boundary_state_groups: frozenset[int],
+        *,
+        save_decode_cache: bool = False,
+    ) -> list["LMCacheMPRequestMetadata"]:
+        """Build state-only stores from vLLM's exact boundary handoffs.
+
+        This can backfill an earlier chunk after the attention store cursor has
+        advanced. The caller must pin every non-null block until all workers
+        finish the transfer, and fence reads after the step's model/CoW writes.
+
+        Args:
+            tracker: Request identity, tokens, and offload limits.
+            boundary_states: Scheduler handoffs as (group, block, token boundary).
+            lmcache_tokens_per_chunk: Server chunk size, in tokens.
+            group_tokens_per_block: Engine group geometry; zero denotes scratch.
+            boundary_state_groups: Checkpoint groups excluded from positional
+                stores. Each must have a block size equal to the server chunk.
+            save_decode_cache: Whether generated-token chunks may be stored.
+
+        Returns:
+            One store per eligible chunk boundary, with all unrelated groups
+            null. Boundaries inside a server chunk are skipped, never rounded.
+
+        Raises:
+            ValueError: If a checkpoint group does not span exactly one chunk.
+        """
+        for group_id in boundary_state_groups:
+            if group_tokens_per_block[group_id] != lmcache_tokens_per_chunk:
+                raise ValueError("Boundary state groups require one block per chunk")
+        limit = tracker.num_scheduled_tokens + max(
+            tracker.num_vllm_hit_tokens, tracker.num_lmcache_hit_tokens
+        )
+        token_ids = tracker.get_token_ids()
+        limit = min(limit, len(token_ids))
+        if not save_decode_cache:
+            limit = min(limit, tracker.num_prompt_tokens)
+        if tracker.max_offload_tokens is not None:
+            limit = min(limit, tracker.max_offload_tokens)
+        chunks: dict[int, list[list[int]]] = {}
+        for group_id, block_id, boundary in boundary_states:
+            if (
+                group_id not in boundary_state_groups
+                or block_id == 0
+                or boundary <= 0
+                or boundary > limit
+                or boundary % lmcache_tokens_per_chunk
+            ):
+                continue
+            if boundary not in chunks:
+                chunks[boundary] = [
+                    [0] * (lmcache_tokens_per_chunk // span) if span else []
+                    for span in group_tokens_per_block
+                ]
+            chunks[boundary][group_id] = [block_id]
+        return [
+            LMCacheMPRequestMetadata(
+                request_id=tracker.request_id,
+                direction="STORE",
+                op=LoadStoreOp(
+                    token_ids=token_ids,
+                    block_ids=blocks,
+                    start=boundary - lmcache_tokens_per_chunk,
+                    end=boundary,
+                    is_partial_store=True,
+                ),
+                cache_salt=tracker.cache_salt,
+                request_configs=tracker.request_configs,
+            )
+            for boundary, blocks in sorted(chunks.items())
+        ]
+
