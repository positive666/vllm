+@pytest.mark.parametrize("lazy", [False, True])
+@pytest.mark.parametrize("failure_at", ["query", "result"])
+def test_store_poll_error_retains_all_chunk_events(
+    fake_adapter, lazy: bool, failure_at: str
+) -> None:
+    """One terminal chunk does not settle another chunk's unknown outcome."""
+    adapter, _, _ = fake_adapter
+    adapter.lazy_offload = lazy
+    first, second = MagicMock(), MagicMock()
+    first.query.return_value = second.query.return_value = True
+    first.result.return_value = second.result.return_value = True
+    getattr(second, failure_at).side_effect = ConnectionError("completion unknown")
+    adapter.transfer_ctx = MagicMock()
+    adapter.transfer_ctx.submit_store.side_effect = [first, second]
+    events = [FakeCudaEvent(), FakeCudaEvent()]
+    refs = [weakref.ref(event) for event in events]
+    for event in events:
+        adapter.submit_store_request("request", _op([[12]]), event)
+    adapter.transfer_ctx.reset_mock()
+    del events, event
+    with pytest.raises(ConnectionError, match="completion unknown"):
+        if lazy:
+            adapter.get_finished_with_lazy_offload()
+        else:
+            adapter.get_finished({"request"})
+    assert adapter.get_completed_store_requests() is None
+    gc.collect()
+    assert all(ref() is not None for ref in refs)
+
