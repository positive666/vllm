+@pytest.mark.parametrize("lazy", [False, True])
+def test_store_completion_waits_for_every_chunk_and_keeps_every_event(
+    fake_adapter, lazy: bool
+) -> None:
+    """A later chunk finishing cannot release an earlier remote reader."""
+    adapter, _, _ = fake_adapter
+    adapter.lazy_offload = lazy
+    first, second = MagicMock(), MagicMock()
+    first.query.return_value = False
+    second.query.return_value = True
+    first.result.return_value = second.result.return_value = True
+    adapter.transfer_ctx = MagicMock()
+    adapter.transfer_ctx.submit_store.side_effect = [first, second]
+    events = [FakeCudaEvent(), FakeCudaEvent()]
+    refs = [weakref.ref(event) for event in events]
+    for event in events:
+        adapter.submit_store_request("request", _op([[12]]), event)
+    adapter.transfer_ctx.reset_mock()
+    del events, event
+    gc.collect()
+
+    def poll():
+        if lazy:
+            adapter.get_finished_with_lazy_offload()
+            return adapter.get_completed_store_requests()
+        return adapter.get_finished({"request"})[0]
+
+    assert not poll()
+    assert all(ref() is not None for ref in refs)
+    first.query.return_value = True
+    assert poll() == ({"request": 1} if lazy else {"request"})
+    assert not poll()
+    gc.collect()
+    assert all(ref() is None for ref in refs)
+
