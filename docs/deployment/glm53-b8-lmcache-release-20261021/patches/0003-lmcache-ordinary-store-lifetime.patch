+def test_preemption_waits_for_all_chunks_before_flushing_sources(
+    fake_adapter, monkeypatch
+) -> None:
+    """A timeout stops forward; a successful drain includes displaced chunks."""
+    adapter, _, _ = fake_adapter
+    adapter.transfer_ctx = MagicMock()
+    first, second = MagicMock(), MagicMock()
+    first.result.side_effect = TimeoutError("copy remains in flight")
+    second.result.return_value = True
+    adapter.transfer_ctx.submit_store.side_effect = [first, second]
+    for _ in range(2):
+        adapter.submit_store_request("request", _op([[12]]), FakeCudaEvent())
+    sync = MagicMock()
+    monkeypatch.setattr(adapter_mod.torch_dev, "synchronize", sync)
+    adapter.handle_preemptions(False)
+    first.result.assert_not_called()
+    with pytest.raises(TimeoutError, match="in flight"):
+        adapter.handle_preemptions(True)
+    adapter.transfer_ctx.flush_inflight_stores.assert_not_called()
+    sync.assert_not_called()
+    first.result.side_effect = None
+    first.result.return_value = True
+    adapter.handle_preemptions(True)
+    second.result.assert_called_once()
+    adapter.transfer_ctx.flush_inflight_stores.assert_called_once()
+    sync.assert_called_once()
