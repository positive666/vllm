+def test_store_submission_error_retains_event_and_blocks_preemption(
+    fake_adapter,
+) -> None:
+    """Unknown admission cannot be followed by source reuse or a new store."""
+    adapter, _, _ = fake_adapter
+    adapter.transfer_ctx = MagicMock()
+    adapter.transfer_ctx.submit_store.side_effect = ConnectionError("admission unknown")
+    event = FakeCudaEvent()
+    ref = weakref.ref(event)
+    with pytest.raises(ConnectionError, match="admission unknown"):
+        adapter.submit_store_request("request", _op([[12]]), event)
+    adapter.transfer_ctx.reset_mock()
+    del event
+    with pytest.raises(RuntimeError, match="submission outcome unknown"):
+        adapter.get_finished({"request"})
+    with pytest.raises(RuntimeError, match="submission outcome unknown"):
+        adapter.handle_preemptions(True)
+    with pytest.raises(RuntimeError, match="submission outcome unknown"):
+        adapter.submit_store_request("later", _op([[13]]), None)
+    gc.collect()
+    assert ref() is not None
+    adapter.transfer_ctx.flush_inflight_stores.assert_not_called()
+
