+@pytest.mark.parametrize("lazy", [False, True])
+def test_heartbeat_loss_cannot_complete_an_admitted_store(
+    fake_adapter, lazy: bool
+) -> None:
+    """A lost heartbeat stops progress before any receipt or event release."""
+    adapter, _, _ = fake_adapter
+    adapter.lazy_offload = lazy
+    adapter.transfer_ctx = MagicMock()
+    future = adapter.transfer_ctx.submit_store.return_value
+    future.query.return_value = False
+    event = FakeCudaEvent()
+    ref = weakref.ref(event)
+    adapter.submit_store_request("request", _op([[12]]), event)
+    adapter.transfer_ctx.reset_mock()
+    del event
+    FakeHeartbeatThread.instances[-1].health_event.clear()
+    poll = (
+        adapter.get_finished_with_lazy_offload
+        if lazy
+        else lambda: adapter.get_finished({"request"})
+    )
+    with pytest.raises(RuntimeError, match="heartbeat lost"):
+        poll()
+    with pytest.raises(RuntimeError, match="heartbeat lost"):
+        adapter.handle_preemptions(True)
+    assert adapter.get_completed_store_requests() is None
+    assert adapter.get_failed_store_requests() is None
+    assert "request" in adapter.store_futures
+    gc.collect()
+    assert ref() is not None
+    adapter.transfer_ctx.flush_inflight_stores.assert_not_called()
+    FakeHeartbeatThread.instances[-1].health_event.set()
+    future.query.return_value = True
+    future.result.return_value = True
+    assert poll()[0] == (None if lazy else {"request"})
+    if lazy:
+        assert adapter.get_completed_store_requests() == {"request": 1}
+    gc.collect()
+    assert ref() is None
+
